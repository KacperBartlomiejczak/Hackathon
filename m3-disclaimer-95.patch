 # M3 phrase rules: regex (case-insensitive, Polish inflection tolerant) -> weight. rules score = min(1, sum of distinct hits).
-version: m3-rules-v3
+version: m3-rules-v4
+# Sentences matching `disclaimer` (legal "not a recommendation" boilerplate) are never evidence: rules skip them, the LLM never sees them.
+disclaimer: 'nie (?:jest|stanowi|są|należy traktować)\b[^.!?\n]{0,80}(?:rekomendacj|porad|doradztw|ofert|zachęt)|informacyjn\w+ i edukacyjn\w+|nie (?:udzielamy|udzielam|świadczymy|świadczę) (?:porad|doradztw)'
 rules:
   - {id: advisory_offer, weight: 0.35, pattern: 'doradz\w+ inwestycyjn\w+|doradc\w+ inwestycyjn\w+|indywidualn\w+ doradztw\w+|rekomendacj\w+ inwestycyjn\w+|indywidualn\w+ rekomendacj\w+'}
   - {id: portfolio_management, weight: 0.4, pattern: 'zarządza\w* (?:tw\w+ )?(?:portfel\w*|kapitał\w*|aktyw\w*|pieniędz\w*)|prowadzę (?:tw\w+ )?portfel\w*'}
