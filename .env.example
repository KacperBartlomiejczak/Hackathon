# =============================================================================
# InvestWatch — konfiguracja środowiska (.env.example)
# Skopiuj ten plik do .env: cp .env.example .env
# Uzupełnij sekrety lokalnie — NIGDY nie commituj pliku .env do repozytorium.
# =============================================================================

# --- PostgreSQL 16 + pgvector (port 5432) ---
# Nazwa bazy danych aplikacji
POSTGRES_DB=investwatch
# Użytkownik PostgreSQL
POSTGRES_USER=investwatch
# Hasło do PostgreSQL (UZUPEŁNIJ przed startem, np. wygeneruj losowe)
POSTGRES_PASSWORD=
# Pełny connection string dla api, collector, ai (host w Docker Compose: postgres)
# Przykład: postgresql://investwatch:<POSTGRES_PASSWORD>@postgres:5432/investwatch
DATABASE_URL=

# --- Valkey 8 (kolejka BullMQ, port 6379) ---
# URL połączenia z Valkey (kompatybilny z protokołem Redis)
VALKEY_URL=redis://valkey:6379

# --- SeaweedFS S3 (object storage, port 8333) ---
# Wewnętrzny endpoint S3 w sieci Docker Compose
S3_ENDPOINT=http://seaweedfs:8333
# Nazwa bucketa na surowe HTML i screenshoty
S3_BUCKET=investwatch
# Region S3 (wymagany przez SDK AWS)
S3_REGION=eu-central-1
# Klucz dostępu S3 (UZUPEŁNIJ, jeśli włączona autoryzacja S3)
S3_ACCESS_KEY=
# Sekretny klucz S3 (UZUPEŁNIJ, jeśli włączona autoryzacja S3)
S3_SECRET_KEY=

# --- Ollama (lokalne modele LLM i embeddingi, port 11434) ---
# Adres serwera Ollama w sieci Docker Compose
OLLAMA_URL=http://ollama:11434
# Model do embeddingów (1024 wymiary, zgodnie z tabelą documents)
OLLAMA_EMBED_MODEL=bge-m3
# Model LLM do klasyfikacji i analizy (np. hf.co/speakleash/Bielik-11B-v2.3-Instruct-GGUF:Q4_K_M lub gemma2:9b)
OLLAMA_LLM_MODEL=hf.co/speakleash/Bielik-11B-v2.3-Instruct-GGUF:Q4_K_M

# --- Komunikacja między serwisami ---
# URL serwisu AI (FastAPI, port 8000)
AI_URL=http://ai:8000
# URL backendu API (Fastify, port 3000)
API_URL=http://api:3000
# Wspólny token do endpointu POST /internal/alerts (nagłówek X-Internal-Token) — UZUPEŁNIJ
INTERNAL_TOKEN=

# --- Web (Vite + React, port 5173) ---
# Adres API dostępny z przeglądarki użytkownika
VITE_API_URL=http://localhost:3000
# Dozwolony origin CORS po stronie API
CORS_ORIGIN=http://localhost:5173

# --- Collector (Playwright + BullMQ) ---
# Katalog na lokalne dane (np. próbki offline) wewnątrz kontenera
DATA_DIR=/data
# Plik ze źródłami dla collectora
SOURCES_FILE=sources.yaml
# Opcjonalna lista proxy oddzielona przecinkami (np. http://user:pass@host:port)
PROXY_LIST=

# --- Logowanie ---
# Poziom logów (info | debug | warn | error)
LOG_LEVEL=info
